{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/gate4/approval_config.schema.json",
  "title": "Gate 4 Approval Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "data_classification",
    "as_of_date",
    "designated_partner",
    "system_assessment_required",
    "automatic_trade_execution",
    "external_transmission_policy",
    "allowed_decisions",
    "partner_decision",
    "reviewed_by",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "document_type": {"const": "approval_config"},
    "data_classification": {
      "enum": ["PRIVATE_PORTFOLIO", "SYNTHETIC_PUBLIC_EXAMPLE"]
    },
    "as_of_date": {"type": "string", "format": "date"},
    "designated_partner": {"type": "string", "minLength": 2, "maxLength": 256},
    "system_assessment_required": {"const": true},
    "automatic_trade_execution": {"const": false},
    "external_transmission_policy": {"const": "DENY"},
    "allowed_decisions": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["PENDING", "APPROVED", "MODIFIED", "REJECTED", "DEFERRED"]
      }
    },
    "partner_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "assessment_hash",
        "approved_by",
        "approved_at",
        "decision_rationale",
        "approved_position_basis",
        "approved_position_min",
        "approved_position_max",
        "acknowledged_escalation_ids"
      ],
      "properties": {
        "status": {
          "enum": ["PENDING", "APPROVED", "MODIFIED", "REJECTED", "DEFERRED"]
        },
        "assessment_hash": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "approved_by": {"type": ["string", "null"], "maxLength": 256},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "decision_rationale": {"type": ["string", "null"], "maxLength": 4000},
        "approved_position_basis": {
          "type": ["string", "null"],
          "enum": ["TOTAL_ISSUER_GROSS_LONG_WEIGHT", null]
        },
        "approved_position_min": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "approved_position_max": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "acknowledged_escalation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "reviewed_by": {"type": "string", "minLength": 2, "maxLength": 256},
    "reviewed_at": {"type": "string", "format": "date-time"}
  }
}
