{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/monitoring/monitoring_output.schema.json",
  "title": "S15 Monitoring Update Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "monitoring_output_contract_version",
    "monitoring_engine_version",
    "generated_at",
    "requested_monitoring_as_of_date",
    "monitoring_as_of_date",
    "status",
    "issuer_identity",
    "previous_contract_identity",
    "current_contract_identity",
    "policy_identity",
    "input_validation",
    "change_summary",
    "fact_changes",
    "calculation_changes",
    "judgment_changes",
    "evidence_changes",
    "warning_changes",
    "hard_stop_changes",
    "kpi_assessments",
    "kpi_breach_summary",
    "scenario_impact",
    "probability_expiration",
    "system_thesis_assessment",
    "formal_thesis_status",
    "automatic_trade_execution",
    "monitoring_hash",
    "contract_validation"
  ],
  "properties": {
    "monitoring_output_contract_version": {"const": "1.0.0"},
    "monitoring_engine_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "requested_monitoring_as_of_date": {"type": "string"},
    "monitoring_as_of_date": {
      "oneOf": [
        {"type": "string", "format": "date"},
        {"type": "null"}
      ]
    },
    "status": {"enum": ["MONITORING_COMPLETE", "MONITORING_BLOCKED"]},
    "issuer_identity": {"type": "object"},
    "previous_contract_identity": {"type": "object"},
    "current_contract_identity": {"type": "object"},
    "policy_identity": {"type": "object"},
    "input_validation": {"type": "object"},
    "change_summary": {"type": "object"},
    "fact_changes": {"type": "array", "items": {"type": "object"}},
    "calculation_changes": {"type": "array", "items": {"type": "object"}},
    "judgment_changes": {"type": "array", "items": {"type": "object"}},
    "evidence_changes": {"type": "object"},
    "warning_changes": {"type": "array", "items": {"type": "object"}},
    "hard_stop_changes": {"type": "array", "items": {"type": "object"}},
    "kpi_assessments": {"type": "array", "items": {"type": "object"}},
    "kpi_breach_summary": {"type": "object"},
    "scenario_impact": {"type": "object"},
    "probability_expiration": {"type": "object"},
    "system_thesis_assessment": {"type": "object"},
    "formal_thesis_status": {"type": "object"},
    "automatic_trade_execution": {"const": false},
    "monitoring_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_validation": {"type": "object"}
  }
}
