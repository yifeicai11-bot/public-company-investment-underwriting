      "validation_method": "ISO date and bundle consistency."
    },
    {
      "document": "exposures",
      "field_path": "exposure_id",
      "modes": ["EXPOSURE_ONLY", "AGGREGATED_PORTFOLIO", "FULL_HOLDINGS"],
      "requirement_class": "CORE_REQUIRED",
