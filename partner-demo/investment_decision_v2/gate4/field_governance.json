      "validation_method": "Schema enum and cross-document consistency."
    },
    {
      "document": "manifest",
      "field_path": "workspace_id",
      "modes": ["EXPOSURE_ONLY", "AGGREGATED_PORTFOLIO", "FULL_HOLDINGS"],
      "requirement_class": "CORE_REQUIRED",
      "validation_method": "Schema validation."
    },
    {
      "document": "manifest",
      "field_path": "as_of_date",
      "modes": ["EXPOSURE_ONLY", "AGGREGATED_PORTFOLIO", "FULL_HOLDINGS"],
      "requirement_class": "CORE_REQUIRED",
      "validation_method": "ISO date and cross-document consistency."
    },
    {
      "document": "manifest",
      "field_path": "input_mode",
      "modes": ["EXPOSURE_ONLY", "AGGREGATED_PORTFOLIO", "FULL_HOLDINGS"],
      "requirement_class": "CORE_REQUIRED",
      "validation_method": "Schema enum."
    },
    {
      "document": "manifest",
      "field_path": "base_currency",
      "modes": ["EXPOSURE_ONLY", "AGGREGATED_PORTFOLIO", "FULL_HOLDINGS"],
