      "modes": ["EXPOSURE_ONLY", "AGGREGATED_PORTFOLIO", "FULL_HOLDINGS"],
      "requirement_class": "CORE_REQUIRED",
      "validation_method": "Schema range; no default value."
    },
    {
      "document": "policy",
      "field_path": "downside_tolerance",
      "modes": ["EXPOSURE_ONLY", "AGGREGATED_PORTFOLIO", "FULL_HOLDINGS"],
