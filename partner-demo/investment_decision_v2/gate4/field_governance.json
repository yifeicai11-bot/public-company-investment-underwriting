{
  "contract_version": "1.2.0",
  "requirement_classes": [
    "CORE_REQUIRED",
    "CONDITIONAL",
    "OPTIONAL",
    "REVIEWER_CONFIRMED_NOT_APPLICABLE"
  ],
  "schema_required_default_class": "CORE_REQUIRED",
  "mode_document_requirements": {
    "EXPOSURE_ONLY": {
      "required_documents": [
        "policy",
        "exposures",
        "opportunities",
        "constraints",
        "approval",
        "freshness"
      ],
      "optional_documents": [],
      "prohibited_documents": ["holdings"]
    },
    "AGGREGATED_PORTFOLIO": {
      "required_documents": [
        "policy",
        "exposures",
        "holdings",
        "opportunities",
        "constraints",
        "approval",
        "freshness"
      ],
      "optional_documents": [],
      "prohibited_documents": []
    },
    "FULL_HOLDINGS": {
      "required_documents": [
        "policy",
        "holdings",
        "opportunities",
        "constraints",
        "approval",
        "freshness"
      ],
      "optional_documents": ["exposures"],
      "prohibited_documents": []
    }
  },
