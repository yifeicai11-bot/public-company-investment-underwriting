{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/gate4/exposure_row.schema.json",
  "title": "Gate 4 Exposure Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data_classification",
    "as_of_date",
    "exposure_id",
    "exposure_type",
    "exposure_key",
    "measurement_basis",
    "exposure_weight",
    "market_value_base_currency",
    "base_currency",
    "source_basis",
    "source_locator",
    "data_owner",
    "reviewed_at"
  ],
  "properties": {
    "data_classification": {
      "enum": ["PRIVATE_PORTFOLIO", "SYNTHETIC_PUBLIC_EXAMPLE"]
    },
    "as_of_date": {"type": "string", "format": "date"},
    "exposure_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "exposure_type": {
      "enum": [
        "ISSUER",
        "SECTOR",
        "COUNTRY",
        "CORRELATION_BUCKET",
        "GROSS",
        "NET",
        "CASH",
        "HEDGE"
      ]
    },
    "exposure_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "measurement_basis": {
      "enum": [
        "GROSS_LONG_WEIGHT",
        "AGGREGATE_GROSS_EXPOSURE",
        "AGGREGATE_NET_EXPOSURE",
        "SIGNED_PORTFOLIO_WEIGHT"
      ]
    },
    "exposure_weight": {"type": "number", "minimum": -5, "maximum": 5},
    "market_value_base_currency": {"type": ["number", "null"]},
    "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "source_basis": {
      "enum": [
        "AGGREGATED_INTERNAL_REPORT",
        "FULL_HOLDINGS_DERIVED",
        "MANUAL_REVIEWED"
      ]
    },
    "source_locator": {"type": ["string", "null"], "maxLength": 512},
    "data_owner": {"type": "string", "minLength": 2, "maxLength": 256},
    "reviewed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "exposure_type": {
            "enum": ["ISSUER", "SECTOR", "COUNTRY", "CORRELATION_BUCKET"]
          }
        },
        "required": ["exposure_type"]
      },
      "then": {
        "properties": {
          "measurement_basis": {"const": "GROSS_LONG_WEIGHT"}
        }
      }
    },
    {
      "if": {
        "properties": {"exposure_type": {"const": "GROSS"}},
        "required": ["exposure_type"]
      },
      "then": {
        "properties": {
          "measurement_basis": {"const": "AGGREGATE_GROSS_EXPOSURE"}
        }
      }
    },
    {
      "if": {
        "properties": {"exposure_type": {"const": "NET"}},
        "required": ["exposure_type"]
      },
      "then": {
        "properties": {
          "measurement_basis": {"const": "AGGREGATE_NET_EXPOSURE"}
        }
      }
    },
    {
      "if": {
        "properties": {"exposure_type": {"enum": ["CASH", "HEDGE"]}},
        "required": ["exposure_type"]
      },
      "then": {
        "properties": {
          "measurement_basis": {"const": "SIGNED_PORTFOLIO_WEIGHT"}
        }
      }
    }
  ]
}
