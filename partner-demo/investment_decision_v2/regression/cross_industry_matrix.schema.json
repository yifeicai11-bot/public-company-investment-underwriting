{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/regression/cross_industry_matrix.schema.json",
  "title": "Cross-Industry Regression Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "phase",
    "session",
    "as_of_date",
    "supported_core",
    "coverage_policy",
    "shared_analytical_files",
    "stress_characteristics",
    "cases",
    "synthetic_safety_cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "document_type": {
      "const": "cross_industry_regression_matrix"
    },
    "phase": {
      "const": "B"
    },
    "session": {
      "const": "S06"
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "supported_core": {
      "type": "string",
      "minLength": 1
    },
    "coverage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_active_cases",
        "minimum_active_industries",
        "required_safe_outcomes",
        "planned_coverage_is_not_tested"
      ],
      "properties": {
        "minimum_active_cases": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_active_industries": {
          "type": "integer",
          "minimum": 1
        },
        "required_safe_outcomes": {
          "$ref": "#/$defs/stringArray"
        },
        "planned_coverage_is_not_tested": {
          "const": true
        }
      }
    },
    "shared_analytical_files": {
      "$ref": "#/$defs/stringArray"
    },
    "stress_characteristics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stress_id",
          "description"
        ],
        "properties": {
          "stress_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "synthetic_safety_cases": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "outcome_id",
          "test_method"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^SF-[A-Z0-9-]+$"
          },
          "outcome_id": {
            "type": "string",
            "minLength": 1
          },
          "test_method": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "fixture_status",
        "fixture_role",
        "industry",
        "business_model",
        "source_scope",
        "stress_characteristics",
        "required_assertions",
        "required_safe_outcomes",
        "analytical_logic_hardcoding_allowed",
        "selection_rule"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^CI-[A-Z0-9-]+$"
        },
        "fixture_status": {
          "enum": [
            "ACTIVE",
            "PLANNED"
          ]
        },
        "fixture_role": {
          "enum": [
            "regression",
            "preserved_forward",
            "planned_slot"
          ]
        },
        "ticker": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9.-]+$"
        },
        "company_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "industry": {
          "type": "string",
          "minLength": 1
        },
        "business_model": {
          "type": "string",
          "minLength": 1
        },
        "source_scope": {
          "const": "PUBLIC_DATA_ONLY"
        },
        "stress_characteristics": {
          "$ref": "#/$defs/stringArray"
        },
        "required_assertions": {
          "$ref": "#/$defs/stringArray"
        },
        "required_safe_outcomes": {
          "$ref": "#/$defs/stringArray"
        },
        "analytical_logic_hardcoding_allowed": {
          "const": false
        },
        "selection_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fixture_status": {
                "const": "ACTIVE"
              }
            }
          },
          "then": {
            "required": [
              "ticker",
              "company_name"
            ],
            "properties": {
              "ticker": {
                "type": "string"
              },
              "company_name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fixture_status": {
                "const": "PLANNED"
              }
            }
          },
          "then": {
            "properties": {
              "ticker": {
                "const": null
              },
              "company_name": {
                "const": null
              },
              "fixture_role": {
                "const": "planned_slot"
              }
            }
          }
        }
      ]
    }
  }
}
