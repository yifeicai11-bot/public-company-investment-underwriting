{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/blind-tests/blind_test_manifest.schema.json",
  "title": "Public Company Blind Forward Test Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "phase",
    "session",
    "status",
    "selection_date",
    "pre_run_commit",
    "pre_run_shared_logic",
    "selection_method",
    "candidate_pool",
    "excluded_prior_issuers",
    "selected_issuer",
    "intended_stress_characteristics",
    "blindness_attestation",
    "first_run_protocol",
    "required_preservation"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "blind_company_forward_test_manifest"},
    "phase": {"enum": ["B", "F"]},
    "session": {"pattern": "^S[0-9]{2}$"},
    "status": {"const": "SELECTED_NOT_RUN"},
    "selection_date": {"type": "string", "format": "date"},
    "attempt": {"enum": ["PRIMARY", "SECONDARY", "FINAL_AFTER_FIX", "FINAL_RENDERER_AFTER_FIX"]},
    "selection_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exchange_list_url",
        "exchange_list_sha256",
        "retrieved_at",
        "selected_cik",
        "selected_submission_url",
        "selected_sic",
        "selected_sic_description"
      ],
      "properties": {
        "exchange_list_url": {"type": "string", "format": "uri"},
        "exchange_list_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "selected_cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "selected_submission_url": {"type": "string", "format": "uri"},
        "selected_sic": {"type": "string", "pattern": "^[0-9]{4}$"},
        "selected_sic_description": {"type": "string", "minLength": 1}
      }
    },
    "pre_run_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "pre_run_shared_logic": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      }
    },
    "selection_method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "seed_material",
        "seed_sha256",
        "index_formula",
        "selected_index"
      ],
      "properties": {
        "method": {"const": "SHA256_MODULO_PREDECLARED_POOL"},
        "seed_material": {"type": "string", "minLength": 1},
        "seed_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "index_formula": {"const": "int(seed_sha256, 16) % candidate_pool_length"},
        "selected_index": {"type": "integer", "minimum": 0}
      }
    },
    "candidate_pool": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"}
    },
    "excluded_prior_issuers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticker", "reason"],
        "properties": {
          "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "selected_issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "company_name", "exchange", "industry"],
      "properties": {
        "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
        "company_name": {"type": "string", "minLength": 1},
        "exchange": {"type": "string", "minLength": 1},
        "industry": {"type": "string", "minLength": 1}
      }
    },
    "intended_stress_characteristics": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "blindness_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_before_first_run",
        "no_ticker_specific_adjustment_before_first_run",
        "selected_ticker_absent_from_pre_run_shared_logic",
        "company_will_not_be_replaced_if_first_run_fails",
        "selection_not_based_on_expected_result"
      ],
      "properties": {
        "selected_before_first_run": {"const": true},
        "no_ticker_specific_adjustment_before_first_run": {"const": true},
        "selected_ticker_absent_from_pre_run_shared_logic": {"const": true},
        "company_will_not_be_replaced_if_first_run_fails": {"const": true},
        "selection_not_based_on_expected_result": {"const": true}
      }
    },
    "first_run_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder",
        "research_input",
        "output_directory",
        "network_scope",
        "overwrite_existing_first_run"
      ],
      "properties": {
        "builder": {
          "enum": [
            "build_public_company_investment_layer.py",
            "underwrite.py"
          ]
        },
        "research_input": {"type": "null"},
        "output_directory": {"const": "first_run"},
        "network_scope": {"const": "PUBLIC_DATA_ONLY"},
        "overwrite_existing_first_run": {"const": false}
      }
    },
    "required_preservation": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EXACT_COMMAND",
          "RUNTIME_AND_COMMIT",
          "STDOUT",
          "STDERR",
          "BUILDER_OUTPUT",
          "ERRORS",
          "WARNINGS",
          "DIAGNOSTIC_REPORT",
          "FIX_RECORD",
          "POST_FIX_REGRESSION"
        ]
      }
    }
  }
}
